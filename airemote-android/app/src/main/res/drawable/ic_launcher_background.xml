<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层：品牌渐变。
  取值来自 docs/ui/design-principles.md §4.1.1 的 linear-gradient(135deg, #0E9F86 → #18C9A6)，
  与 Android 端 Brand.kt、以及应用图标的成品保持一致。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF0E9F86" />
                <item android:offset="1" android:color="#FF18C9A6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
