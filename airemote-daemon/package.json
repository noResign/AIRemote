{
  "name": "@noresign/airemote",
  "version": "1.5.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "description": "Remote-control your local coding agent from your phone: headless Claude Code, streaming events over HTTP/SSE, session resume, remote tool-call approval.",
  "license": "Apache-2.0",
  "author": "noResign",
  "homepage": "https://github.com/noResign/AIRemote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noResign/AIRemote.git",
    "directory": "airemote-daemon"
  },
  "bugs": "https://github.com/noResign/AIRemote/issues",
  "keywords": [
    "claude-code",
    "coding-agent",
    "remote-control",
    "headless",
    "sse",
    "daemon",
    "mobile"
  ],
  "bin": {
    "airemote": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "client",
    ".env.example"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "~24"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.1.0"
  }
}
