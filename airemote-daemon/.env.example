# 复制本文件为 .env 后按需修改（.env 已被 gitignore，不会入库）。
# 所有变量都可被命令行 flag 覆盖；命令行 flag 优先。

# 监听地址（0.0.0.0 = 局域网可访问）
AIREMOTE_HOST=0.0.0.0
AIREMOTE_PORT=4780

# 初始 Workspace 根目录（首次启动注册为默认 Workspace；之后可在手机上切换）
AIREMOTE_WORKSPACE=/home/renbin/OpenProject/AIRemote

# 鉴权 token（留空则自动生成并持久化到 <data-dir>/token）
# AIREMOTE_TOKEN=

# 新 Session 默认权限模式 seed：default(=ask) | acceptEdits | plan | bypassPermissions
AIREMOTE_PERMISSION_MODE=default

# 工具审批超时（秒，0/非法值回退 120）
# AIREMOTE_PERMISSION_TIMEOUT_SECONDS=120

# run 空闲看门狗：无事件多少秒后自动取消（0 = 禁用，默认 900）
AIREMOTE_RUN_IDLE_TIMEOUT_SECONDS=900

# 数据目录（SQLite + token，默认 ~/.airemote）
# AIREMOTE_DATA_DIR=~/.airemote

# TLS（可选，生产环境建议）
# AIREMOTE_TLS_CERT=/path/to/cert.pem
# AIREMOTE_TLS_KEY=/path/to/key.pem
